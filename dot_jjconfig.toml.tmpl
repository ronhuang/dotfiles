[user]
name = "Ron Huang"
email = "ron@hng.tw"

[ui]
editor = "emacsclient -t -a=\"\""
pager = "delta"
diff-formatter = ":git"
default-command = "log"

[signing]
behavior = "drop"
backend = "ssh"
key = "ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAICWZuTXkLx/CyLTyxKx57lmDMTSR+f8fg0qX2iqEK8Ul"
{{- $sshSignCandidates := list
    (printf "%s/AppData/Local/Microsoft/WindowsApps/op-ssh-sign.exe" .chezmoi.homeDir)
    "C:/Program Files/1Password/app/8/op-ssh-sign.exe"
    (printf "%s/AppData/Local/1Password/app/8/op-ssh-sign.exe" .chezmoi.homeDir)
    "/Applications/1Password.app/Contents/MacOS/op-ssh-sign"
    "/opt/1Password/op-ssh-sign"
-}}
{{- $sign := "" -}}
{{- range $sshSignCandidates -}}
  {{- if and (not $sign) (. | lstat) -}}
    {{- $sign = . -}}
  {{- end -}}
{{- end }}
backends.ssh.program = "{{ $sign }}"
backends.ssh.allowed-signers = "{{ .chezmoi.homeDir }}/.config/git/allowed_signers"

[git]
sign-on-push = true

[merge-tools.difft]
diff-args = ["--color=always", "$left", "$right"]

[merge-tools.bc]
program = "bcomp"
edit-args = ["$left", "$right", "/leftreadonly", "/expandall"]
merge-args = ["$left", "$right", "$base", "$output", "/automerge", "/reviewconflicts"]

[merge-tools.bc-3]
program = "bcomp"
edit-args = ["$left", "$right", "/expandall", "/mergeoutput=$right", "/leftreadonly", "/rightreadonly"]

[aliases]
lg = ['log', '-r', 'all()']
df = ['diff']
